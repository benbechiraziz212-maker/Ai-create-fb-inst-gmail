// app/page.jsx
"use client";

import { useState, useRef, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";

const TABS = [
  { id: "facebook", label: "Facebook", icon: "📘", color: "#1877F2" },
  { id: "instagram", label: "Instagram", icon: "📸", color: "#E1306C" },
  { id: "email", label: "البريد الإلكتروني", icon: "✉️", color: "#10b981" },
];

const TONES = ["احترافي", "ودّي", "ترويجي", "ملهِم", "مضحك"];
const GOALS = {
  facebook: ["نشر خبر", "ترويج منتج", "زيادة التفاعل", "إعلان حدث", "محتوى تعليمي"],
  instagram: ["كابشن جذاب", "ريلز أيديا", "ستوري تفاعلية", "هاشتاقات", "محتوى موسمي"],
  email: ["رد على عميل", "رد على شكوى", "رد على استفسار", "بريد شكر", "بريد متابعة"],
};

function Spinner() {
  return (
    <div style={{ display: "flex", justifyContent: "center", padding: "2rem" }}>
      <div className="spinner" />
    </div>
  );
}

function OutputCard({ text, onCopy, copied }) {
  return (
    <motion.div 
      className="output-card"
      initial={{ opacity: 0, y: 10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.4 }}
    >
      <pre className="output-text">{text}</pre>
      <button className="copy-btn" onClick={onCopy}>
        {copied ? "✅ تم النسخ!" : "📋 نسخ"}
      </button>
    </motion.div>
  );
}

export default function Home() {
  const [activeTab, setActiveTab] = useState("facebook");
  const [topic, setTopic] = useState("");
  const [tone, setTone] = useState("احترافي");
  const [goal, setGoal] = useState(GOALS["facebook"][0]);
  const [emailBody, setEmailBody] = useState("");
  const [output, setOutput] = useState("");
  const [loading, setLoading] = useState(false);
  const [copied, setCopied] = useState(false);
  const [error, setError] = useState("");
  const outputRef = useRef(null);

  useEffect(() => {
    setGoal(GOALS[activeTab][0]);
    setOutput("");
    setError("");
  }, [activeTab]);

  useEffect(() => {
    if (output && outputRef.current) {
      outputRef.current.scrollIntoView({ behavior: "smooth" });
    }
  }, [output]);

  async function generate() {
    if (activeTab !== "email" && !topic.trim()) {
      setError("⚠️ يرجى إدخال الموضوع أو الفكرة.");
      return;
    }
    if (activeTab === "email" && !emailBody.trim()) {
      setError("⚠️ يرجى لصق نص الإيميل الوارد.");
      return;
    }

    setError("");
    setLoading(true);
    setOutput("");

    let prompt = "";
    if (activeTab === "facebook") {
      prompt = `أنت خبير محتوى سوشيال ميديا عربي. اكتب منشور فيسبوك ${goal} بأسلوب ${tone} عن الموضوع التالي: "${topic}". اجعله جذاباً، لا يتجاوز 200 كلمة، واختم بسؤال للتفاعل.`;
    } else if (activeTab === "instagram") {
      prompt = `أنت خبير محتوى إنستغرام عربي. اكتب ${goal} بأسلوب ${tone} عن: "${topic}". إذا كان كابشن أضف 20 هاشتاق مناسب. اجعله ملفتنً ومختصراً.`;
    } else {
      prompt = `أنت مساعد احترافي للرد على الإيميلات باللغة العربية. المطلوب: ${goal}. الإيميل الوارد:\n\n"${emailBody}"\n\nاكتب رداً ${tone}اً واضحاً ومختصراً ومهذباً.`;
    }

    try {
      const response = await fetch('/api/generate', {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ prompt }),
      });
      
      if (!response.ok) {
        throw new Error("فشل الاتصال بالخادم");
      }
      
      const data = await response.json();
      
      if (data.error) {
        throw new Error(data.error);
      }
      
      const text = data.content || data.text || data.message || "لم يتم توليد محتوى.";
      setOutput(text);
    } catch (e) {
      setError("❌ حدث خطأ أثناء الاتصال. حاول مرة أخرى.");
      console.error("Generation error:", e);
    } finally {
      setLoading(false);
    }
  }

  function handleCopy() {
    navigator.clipboard.writeText(output);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  }

  return (
    <>
      <style jsx global>{`
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
          font-family: 'Cairo', sans-serif;
          background: #0a0a0f;
          min-height: 100vh;
          direction: rtl;
          color: #e8e8f0;
        }

        .app {
          max-width: 700px;
          margin: 0 auto;
          padding: 2rem 1rem 4rem;
        }

        .header {
          text-align: center;
          margin-bottom: 2.5rem;
        }

        .header-badge {
          display: inline-block;
          background: linear-gradient(135deg, #6c47ff, #e040fb);
          color: #fff;
          font-size: 0.75rem;
          font-weight: 700;
          letter-spacing: 2px;
          padding: 0.3rem 1rem;
          border-radius: 999px;
          margin-bottom: 1rem;
          text-transform: uppercase;
        }

        h1 {
          font-size: 2.4rem;
          font-weight: 900;
          background: linear-gradient(135deg, #ffffff, #a78bfa);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          line-height: 1.2;
          margin-bottom: 0.5rem;
        }

        .subtitle {
          color: #888;
          font-size: 0.95rem;
        }

        .tabs {
          display: flex;
          gap: 0.5rem;
          background: #12121a;
          border-radius: 16px;
          padding: 0.4rem;
          margin-bottom: 2rem;
          border: 1px solid #1e1e2e;
        }

        .tab-btn {
          flex: 1;
          padding: 0.65rem 0.5rem;
          border: none;
          background: transparent;
          color: #666;
          font-family: 'Cairo', sans-serif;
          font-size: 0.9rem;
          font-weight: 600;
          cursor: pointer;
          border-radius: 12px;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.4rem;
        }

        .tab-btn.active {
          background: #1e1e2e;
          color: #fff;
          box-shadow: 0 2px 12px rgba(108,71,255,0.3);
        }

        .card {
          background: #12121a;
          border: 1px solid #1e1e2e;
          border-radius: 20px;
          padding: 1.8rem;
          margin-bottom: 1.5rem;
        }

        label {
          display: block;
          font-size: 0.85rem;
          font-weight: 700;
          color: #a78bfa;
          margin-bottom: 0.5rem;
          letter-spacing: 0.5px;
        }

        input, textarea, select {
          width: 100%;
          background: #0a0a0f;
          border: 1px solid #2a2a3e;
          border-radius: 12px;
          color: #e8e8f0;
          font-family: 'Cairo', sans-serif;
          font-size: 0.95rem;
          padding: 0.75rem 1rem;
          transition: border-color 0.2s;
          outline: none;
          resize: none;
        }

        input:focus, textarea:focus, select:focus {
          border-color: #6c47ff;
          box-shadow: 0 0 0 3px rgba(108, 71, 255, 0.1);
        }

        select option { background: #12121a; }

        .row {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
          margin-bottom: 1.2rem;
        }

        .field { margin-bottom: 1.2rem; }
        .field:last-child { margin-bottom: 0; }

        .generate-btn {
          width: 100%;
          padding: 1rem;
          background: linear-gradient(135deg, #6c47ff, #e040fb);
          border: none;
          border-radius: 14px;
          color: #fff;
          font-family: 'Cairo', sans-serif;
          font-size: 1.1rem;
          font-weight: 700;
          cursor: pointer;
          transition: opacity 0.2s, transform 0.1s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
        }

        .generate-btn:hover { opacity: 0.9; }
        .generate-btn:active { transform: scale(0.98); }
        .generate-btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .error {
          background: #2a0a0a;
          border: 1px solid #7f1d1d;
          color: #fca5a5;
          border-radius: 12px;
          padding: 0.75rem 1rem;
          font-size: 0.9rem;
          margin-bottom: 1rem;
        }

        .output-card {
          background: #12121a;
          border: 1px solid rgba(108, 71, 255, 0.27);
          border-radius: 20px;
          padding: 1.8rem;
          margin-top: 1.5rem;
        }

        .output-text {
          white-space: pre-wrap;
          line-height: 1.8;
          font-size: 1rem;
          color: #e8e8f0;
          font-family: 'Cairo', sans-serif;
          margin-bottom: 1rem;
        }

        .copy-btn {
          background: #1e1e2e;
          border: 1px solid #2a2a3e;
          border-radius: 10px;
          color: #a78bfa;
          font-family: 'Cairo', sans-serif;
          font-size: 0.9rem;
          font-weight: 600;
          padding: 0.5rem 1.2rem;
          cursor: pointer;
          transition: background 0.2s;
        }

        .copy-btn:hover { background: #2a2a3e; }

        .spinner {
          width: 36px;
          height: 36px;
          border: 3px solid #2a2a3e;
          border-top-color: #6c47ff;
          border-radius: 50%;
          animation: spin 0.7s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }
      `}</style>

      <div className="app">
        <div className="header">
          <div className="header-badge">✨ وكيل ذكاء اصطناعي</div>
          <h1>مساعدك الذكي للمحتوى</h1>
          <p className="subtitle">أنشئ محتوى سوشيال ميديا ورودود إيميل احترافية بثوانٍ</p>
        </div>

        <div className="tabs">
          {TABS.map((t) => (
            <button
              key={t.id}
              className={`tab-btn ${activeTab === t.id ? "active" : ""}`}
              onClick={() => setActiveTab(t.id)}
              style={{ 
                color: activeTab === t.id ? "#fff" : "#666",
              }}
            >
              <span>{t.icon}</span>
              <span>{t.label}</span>
            </button>
          ))}
        </div>

        <div className="card">
          {activeTab !== "email" ? (
            <>
              <div className="field">
                <label>💡 الموضوع أو الفكرة</label>
                <input
                  placeholder={`مثال: ${activeTab === "facebook" ? "إطلاق منتج جديد للعناية بالبشرة" : "صورة شروق الشمس في الرياض"}`}
                  value={topic}
                  onChange={(e) => setTopic(e.target.value)}
                />
              </div>
              <div className="row">
                <div>
                  <label>🎯 الهدف</label>
                  <select value={goal} onChange={(e) => setGoal(e.target.value)}>
                    {GOALS[activeTab].map((g) => (
                      <option key={g} value={g}>{g}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label>🎨 الأسلوب</label>
                  <select value={tone} onChange={(e) => setTone(e.target.value)}>
                    {TONES.map((t) => (
                      <option key={t} value={t}>{t}</option>
                    ))}
                  </select>
                </div>
              </div>
            </>
          ) : (
            <>
              <div className="field">
                <label>📩 الإيميل الوارد (الصق نصه هنا)</label>
                <textarea
                  rows={6}
                  placeholder="ضع هنا نص الإيميل الذي تريد الرد عليه..."
                  value={emailBody}
                  onChange={(e) => setEmailBody(e.target.value)}
                />
              </div>
              <div className="row">
                <div>
                  <label>🎯 نوع الرد</label>
                  <select value={goal} onChange={(e) => setGoal(e.target.value)}>
                    {GOALS.email.map((g) => (
                      <option key={g} value={g}>{g}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label>🎨 الأسلوب</label>
                  <select value={tone} onChange={(e) => setTone(e.target.value)}>
                    {TONES.map((t) => (
                      <option key={t} value={t}>{t}</option>
                    ))}
                  </select>
                </div>
              </div>
            </>
          )}

          {error && <div className="error">{error}</div>}

          <button
            className="generate-btn"
            onClick={generate}
            disabled={loading}
          >
            {loading ? "⏳ جاري التوليد..." : "✨ ولّد المحتوى"}
          </button>
        </div>

        {loading && <Spinner />}

        {output && !loading && (
          <div ref={outputRef}>
            <OutputCard text={output} onCopy={handleCopy} copied={copied} />
          </div>
        )}
      </div>
    </>
  );
}
