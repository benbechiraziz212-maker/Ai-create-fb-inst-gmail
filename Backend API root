// app/api/generate/route.js
import { NextResponse } from 'next/server';
import OpenAI from 'openai';

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY || '',
});

export async function POST(request) {
  try {
    const { prompt } = await request.json();
    
    if (!prompt) {
      return NextResponse.json(
        { error: 'Prompt is required' },
        { status: 400 }
      );
    }

    const completion = await openai.chat.completions.create({
      model: "gpt-3.5-turbo",
      messages: [
        { 
          role: "system", 
          content: "You are a helpful Arabic content assistant specialized in social media and email responses. Always respond in Arabic." 
        },
        { role: "user", content: prompt }
      ],
      temperature: 0.7,
      max_tokens: 500,
    });
    
    const content = completion.choices[0].message.content;
    
    return NextResponse.json({ content });
  } catch (error) {
    console.error('OpenAI API Error:', error);
    
    // Provide a fallback response for demo/testing
    if (!process.env.OPENAI_API_KEY || process.env.OPENAI_API_KEY === 'your-api-key-here') {
      return NextResponse.json({ 
        content: "⚠️ يرجى إضافة مفتاح API صحيح في إعدادات Vercel. هذا نص تجريبي: شكراً لاستخدامك المساعد الذكي! 🎉"
      });
    }
    
    return NextResponse.json(
      { error: 'Failed to generate content. Please try again.' },
      { status: 500 }
    );
  }
}
